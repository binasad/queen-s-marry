# Admin Web - Backend API
# Production:
NEXT_PUBLIC_API_URL=https://aztrosyssalonappapi.ddns.net/api/v1
NEXT_PUBLIC_BACKEND_URL=https://aztrosyssalonappapi.ddns.net

# Local development:
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Note: Image uploads go through the backend. For S3 to work, the backend .env must have:
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=salon-app-assets-queensmarry-2026
# AWS_ACCESS_KEY_ID=<your_access_key>
# AWS_SECRET_ACCESS_KEY=<your_secret_key>
# AWS_S3_BASE_URL=https://salon-app-assets-queensmarry-2026.s3.us-east-1.amazonaws.com
