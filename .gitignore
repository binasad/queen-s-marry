# Root-level .gitignore for monorepo
# This complements individual project .gitignore files

# Ignore Gradle and Android build artifacts
**/android/GradleCache/
**/android/.gradle/
**/android/build/
**/android/app/build/
*.pyc
*.log

# Ignore Node modules
**/node_modules/

# Ignore OS files
.DS_Store
Thumbs.db

# OS Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
.cache/

# Environment files (keep .env.example files)
.env
.claude/
.env.local
.env.*.local
!.env.example

# Project-specific env (may contain production URLs / secrets)
admin-web/.env.local
admin-web/.env.local.example
salon-app/.env.example

# Terraform (state, providers, secrets)
terraform/

# Terraform (state, providers, secrets)
terraform/

# Terraform (state, providers, keys, env)
terraform/

# Firebase credentials (NEVER commit)
**/firebase-admin-sdk.json

# Documentation build
docs/_build/
site/
