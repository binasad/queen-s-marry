# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salon_db
DB_USER=postgres
DB_PASSWORD=your_password

# JWT Configuration (required - no defaults in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret
JWT_REFRESH_EXPIRES_IN=30d

# Email Configuration (for verification and password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Salon App <noreply@salonapp.com>

# URLs (local dev - use your machine IP for mobile app on same network)
FRONTEND_URL=http://localhost:3000
ADMIN_WEB_URL=http://localhost:3001
BACKEND_URL=http://192.168.18.112:5000

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# AWS S3 (optional - falls back to local uploads if not set)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BASE_URL=https://your-bucket-name.s3.amazonaws.com

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Appointment Configuration
APPOINTMENT_EXPIRY_HOURS=4
REMINDER_HOURS_BEFORE=3

# Stripe (payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Google Sign-In (Web OAuth client ID for idToken verification)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
