# Salon App - Local Development
# Copy to .env and update values

# Backend API
# Production:
# API_BASE_URL=https://aztrosyssalonappapi.ddns.net/api/v1
# Local (use your machine's IP for physical device on same network):
# API_BASE_URL=http://192.168.18.112:5000/api/v1
API_BASE_URL=https://aztrosyssalonappapi.ddns.net/api/v1

# Google Sign-In (Web OAuth client ID from Firebase/Google Cloud)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Stripe (publishable key - safe to expose in app)

